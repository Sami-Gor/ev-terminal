# Copy to .env and fill in a key. Leave both empty to run the built-in
# simulated feed (the terminal works end-to-end either way).
POLYGON_API_KEY=
FMP_API_KEY=
PORT=3000

# Comma-separated origins allowed to call the API / open the WebSocket feed.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Background market polling
# USE_MOCK_DATA=true  → mock telemetry generator refreshes the cache
# USE_MOCK_DATA=false → external provider quotes (requires an API key)
# (unset → auto: simulated feed without keys, provider quotes with keys)
USE_MOCK_DATA=
