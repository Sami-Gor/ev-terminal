# Copy to .env and fill in keys. Leave empty to run the simulated engine.
# Private self-use only: never distribute a build configured with real keys
# (market-data vendor licenses forbid it) — see README "Data sources".
DISTRIBUTION_MODE=local
POLYGON_API_KEY=your_polygon_key
FMP_API_KEY=your_fmp_key
PORT=3000

# Direct broker execution (Alpaca). PAPER=true routes to paper trading —
# set to false only if you fully accept live-money risk.
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
ALPACA_PAPER=true

# Comma-separated origins allowed to call the API / open the WebSocket feed.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Background market polling
# USE_MOCK_DATA=true  → mock telemetry generator refreshes the cache
# USE_MOCK_DATA=false → external provider quotes (requires an API key)
# (unset → auto: simulated feed without keys, provider quotes with keys)
USE_MOCK_DATA=

# Distribution mode: 'local' (default) lets a developer use personal API keys
# for their own single-user run. 'public' is the distributed build: the app is
# locked to the simulated engine and vendor keys are ignored entirely.
DISTRIBUTION_MODE=local
