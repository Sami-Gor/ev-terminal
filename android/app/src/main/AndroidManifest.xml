<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for the OkHttp WebSocket feed and connectivity awareness. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="EVT Terminal"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic allows the ws:// dev endpoint (10.0.2.2:3000 from the
             emulator). Production builds should use wss:// and drop this flag. -->

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="EVT Terminal"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
